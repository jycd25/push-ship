    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "sync",
    "copy",
    "mirror",
    "deploy",
    "files",
    "cli",
    "claude-code",
    "plugin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
